rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isVolunteer() {
      return signedIn() && userDoc(request.auth.uid).data.role == 'volunteer';
    }

    function isNgo() {
      return signedIn() && userDoc(request.auth.uid).data.role == 'ngo';
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        userDoc(request.auth.uid).data.role == 'ngo' ||
        userDoc(request.auth.uid).data.role == 'volunteer'
      );
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow read: if true;
      allow create: if isNgo() && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if isNgo() && resource.data.organizerId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if signedIn() && (
        resource.data.volunteerUid == request.auth.uid ||
        resource.data.ngoUid == request.auth.uid
      );
      allow create: if signedIn() &&
        request.resource.data.volunteerUid == request.auth.uid &&
        request.resource.data.ngoUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.volunteerUid == request.auth.uid;
      allow update: if false;
    }

    match /applications/{applicationId} {
      allow read: if signedIn() && (
        resource.data.volunteerUid == request.auth.uid ||
        resource.data.ngoUid == request.auth.uid
      );
      allow create: if isVolunteer() &&
        request.resource.data.volunteerUid == request.auth.uid &&
        request.resource.data.ngoUid != request.auth.uid;
      allow update: if signedIn() && resource.data.ngoUid == request.auth.uid;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.recipientUserId == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientUserId == request.auth.uid;
      allow delete: if false;
    }
  }
}
